# Define macros (only works in top-level gitattributes files)
[attr]lfs                       filter=lfs diff=lfs merge=lfs -text
[attr]unity-json                linguist-language=json
[attr]unity-yaml                linguist-language=yaml

# Default text handling
*                               text=auto eol=lf

